@startuml finance-c4-containers

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_LEFT_RIGHT()
LAYOUT_WITH_LEGEND()

title C4 - Containers de Vankoo Finance

Person(mype, "MYPE", "Usa la aplicación web de Vankoo.")
Person(investor, "Inversionista", "Usa la aplicación móvil de Vankoo.")

System_Ext(stripe, "Stripe", "Proveedor externo de pagos y webhooks.")

Enterprise_Boundary(vankoo, "Plataforma Vankoo") {
    Container(web_app, "Vankoo Web App", "Angular", "Aplicación web usada por las MYPE.")
    Container(mobile_app, "Vankoo Mobile App", "Kotlin Multiplatform", "Aplicación móvil usada por los inversionistas.")
    Container(api_gateway, "Vankoo API Gateway", "Spring Cloud Gateway", "Autentica, aplica políticas de entrada y redirige las solicitudes al microservicio correspondiente.")

    System_Boundary(finance_system, "Finance Bounded Context") {
        Container(finance_service, "Finance Service", "Spring Boot + Axon Framework", "Único microservicio desplegable. Recibe comandos y webhooks, ejecuta el agregado Payment, proyecta eventos y publica eventos públicos.")
        ContainerDb(read_model, "Finance Read Model", "PostgreSQL", "Proyección durable y reconstruible para consultas de pagos. No es la fuente de verdad.")
    }

    Container(axon_server, "Axon Server", "Axon Server", "Event Store y router interno de comandos/eventos para las instancias de Finance.")
    ContainerQueue(kafka, "Kafka", "Apache Kafka", "Broker interno de integración entre bounded contexts.")
}

Rel(mype, web_app, "Usa", "HTTPS")
Rel(investor, mobile_app, "Usa", "HTTPS")
Rel(web_app, api_gateway, "Consume la API", "HTTPS/JSON")
Rel(mobile_app, api_gateway, "Consume la API", "HTTPS/JSON")
Rel(api_gateway, finance_service, "Redirige comandos, queries y webhooks", "HTTPS/JSON")
Rel(finance_service, axon_server, "Persiste/reproduce eventos y enruta comandos", "Axon Protocol")
Rel(finance_service, read_model, "Actualiza proyecciones y ejecuta queries", "SQL")
Rel(finance_service, stripe, "Crea/consulta pagos y verifica webhooks", "HTTPS")
Rel(finance_service, kafka, "Publica eventos de dominio públicos", "Kafka/JSON")

SHOW_LEGEND()

@enduml
