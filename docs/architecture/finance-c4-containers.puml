@startuml finance-c4-containers

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_LEFT_RIGHT()
LAYOUT_WITH_LEGEND()

title C4 - Containers de Vankoo Finance (v1: recarga de saldo)

Person(mype, "MYPE", "Usa la aplicación web de Vankoo.")
Person(investor, "Inversionista", "Usa la aplicación móvil de Vankoo.")

System_Ext(stripe, "Stripe", "Proveedor externo de cobros y webhooks.")

Enterprise_Boundary(vankoo, "Plataforma Vankoo") {
    Container(web_app, "Vankoo Web App", "Angular", "Aplicación web usada por las MYPE.")
    Container(mobile_app, "Vankoo Mobile App", "Kotlin Multiplatform", "Aplicación móvil usada por los inversionistas.")
    Container(api_gateway, "Vankoo API Gateway", "Spring Cloud Gateway", "Autentica, aplica políticas de entrada y redirige las solicitudes al microservicio correspondiente. También enruta los webhooks entrantes del proveedor.")

    System_Boundary(finance_system, "Finance Bounded Context") {
        Container(finance_service, "Finance Service", "Spring Boot + Axon Framework 5", "Único microservicio desplegable. Recibe comandos y webhooks, ejecuta el agregado Deposit, proyecta eventos y publica eventos públicos.")
        ContainerDb(finance_db, "Finance Database", "PostgreSQL", "Dos schemas: finance_read_model (proyección deposit_view) y finance_ops (inbox de webhooks, idempotencia y resolución de referencias). Ninguno es la fuente de verdad.")
    }

    Container(axon_server, "Axon Server", "Axon Server", "Event Store y router interno de comandos/eventos para las instancias de Finance.")
    ContainerQueue(kafka, "Kafka", "Apache Kafka", "Broker de integración entre bounded contexts. Topic vankoo.finance.events.v1.")
}

Rel(mype, web_app, "Usa", "HTTPS")
Rel(investor, mobile_app, "Usa", "HTTPS")
Rel(web_app, api_gateway, "Consume la API", "HTTPS/JSON")
Rel(mobile_app, api_gateway, "Consume la API", "HTTPS/JSON")
Rel(api_gateway, finance_service, "Redirige comandos y queries", "HTTPS/JSON")

Rel(stripe, api_gateway, "Envía webhooks de estado", "HTTPS")
Rel(finance_service, stripe, "Crea y consulta cobros", "HTTPS")

Rel(finance_service, axon_server, "Persiste/reproduce eventos y enruta comandos", "Axon Protocol")
Rel(finance_service, finance_db, "Proyecta, consulta y deduplica webhooks", "SQL")
Rel(finance_service, kafka, "Publica eventos de dominio públicos", "Kafka/JSON")

note bottom of finance_db
  Los schemas se separan porque finance_ops
  participa en decisiones de admisión y el
  Read Model no puede hacerlo (ADR-0001).
  Ambos son reconstruibles desde los eventos.
end note

SHOW_LEGEND()

@enduml
