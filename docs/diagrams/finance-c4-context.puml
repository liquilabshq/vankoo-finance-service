@startuml finance-c4-context

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_LEFT_RIGHT()
LAYOUT_WITH_LEGEND()

title C4 - Contexto de Vankoo Finance

Person(mype, "MYPE", "Usa la aplicación web de Vankoo para gestionar sus operaciones financieras.")
Person(investor, "Inversionista", "Usa la aplicación móvil de Vankoo para consultar e iniciar operaciones financieras.")

System_Boundary(vankoo, "Plataforma Vankoo") {
    System(finance, "Vankoo Finance Service", "Bounded Context responsable del ciclo de vida de los pagos y sus eventos de negocio.")
}
System_Ext(stripe, "Stripe", "Proveedor externo de pagos que crea recursos de pago y envía webhooks.")

Rel(mype, finance, "Gestiona operaciones financieras a través de Vankoo")
Rel(investor, finance, "Consulta e inicia operaciones a través de Vankoo")
Rel(finance, stripe, "Crea y consulta pagos", "HTTPS")
Rel(stripe, finance, "Envía webhooks", "HTTPS")

SHOW_LEGEND()

@enduml
