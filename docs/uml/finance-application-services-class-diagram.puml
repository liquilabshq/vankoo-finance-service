    BackgroundColor<<Service>> #FFFFFF/FFE0B2
    BackgroundColor<<Aggregate Root>> #FFFFFF/B3E5FC
    BackgroundColor<<Outbound Service>> #FFFFFF/CFD8DC
    BackgroundColor<<Repository>> #FFFFFF/ECEFF1
