package "domain.services" {
    interface "DepositCommandService" <<(S, #FF8A65) Domain Service>> {
        + handle(command : InitiateDepositCommand) : DepositId
    }

    interface "DepositQueryService" <<(S, #FF8A65) Domain Service>> {
        + getDepositById(query : GetDepositByIdQuery) : Optional<DepositSummary>
        + listDepositsByAccount(query : ListDepositsByAccountQuery) : DepositSummaryPage
    }

    interface "WalletQueryService" <<(S, #FF8A65) Domain Service>> {
        + getWalletBalance(query : GetWalletBalanceQuery) : Optional<WalletBalance>
        + listWalletMovements(query : ListWalletMovementsQuery) : WalletMovementPage
    }

    interface "WebhookInboxService" <<(S, #FF8A65) Domain Service>> {
        + accept(update : VerifiedProviderDepositUpdate, payloadRef : String) : InboxAdmission
        + resolveAndApply() : void
    }
}

package "domain.model.aggregates" {
    class "Deposit" <<(A, #27D3F5) Aggregate Root>> {
        + Deposit(command : InitiateDepositCommand)
        + handle(command : ApplyProviderDepositUpdateCommand) : void
    }
}

package "application.internal.commandservices" {
    class "DepositCommandServiceImpl" <<(V, #FFA726) Service>> {
        - idempotencyRepository : DepositCommandIdempotencyRepository
        - commandGateway : CommandGateway
        + handle(command : InitiateDepositCommand) : DepositId
    }

    class "WebhookInboxServiceImpl" <<(V, #FFA726) Service>> {
        - inboxRepository : ProviderWebhookInboxRepository
        - referenceRepository : DepositProviderReferenceRepository
        - commandGateway : CommandGateway
        + accept(update : VerifiedProviderDepositUpdate, payloadRef : String) : InboxAdmission
        + resolveAndApply() : void
    }
}

package "application.internal.eventhandlers" {
    class "DepositProviderReferenceRegisteredEventHandler" <<(V, #FFA726) Service>> {
        - referenceRepository : DepositProviderReferenceRepository
        + on(event : DepositProviderReferenceRegisteredEvent) : void
    }
}

package "application.internal.queryservices" {
    class "DepositQueryServiceImpl" <<(V, #FFA726) Service>> {
        - depositViewRepository : DepositViewRepository
        + getDepositById(query : GetDepositByIdQuery) : Optional<DepositSummary>
        + listDepositsByAccount(query : ListDepositsByAccountQuery) : DepositSummaryPage
    }

    class "DepositProjection" <<(V, #FFA726) Service>> {
        - depositViewRepository : DepositViewRepository
        + on(event : DepositInitiatedEvent) : void
        + on(event : DepositSucceededEvent) : void
    }

    class "WalletProjection" <<(V, #FFA726) Service>> {
        - walletViewRepository : WalletViewRepository
        - walletMovementRepository : WalletMovementRepository
        + on(event : WalletOpenedEvent) : void
        + on(event : WalletCreditedEvent) : void
        + on(event : WalletDebitedEvent) : void
        + getWalletBalance(query : GetWalletBalanceQuery) : Optional<WalletBalance>
        + listWalletMovements(query : ListWalletMovementsQuery) : WalletMovementPage
    }
}

package "application.internal.outboundservices" {
    interface "PaymentProvider" <<(O, #78909C) Outbound Service>> {
        + createDeposit(idempotencyKey : IdempotencyKey, depositId : DepositId, amount : Money, description : String) : ProviderDepositCreated
        + getDeposit(provider : Provider, providerDepositId : ProviderDepositId) : ProviderDepositStatus
        + verifyWebhook(rawPayload : String, signature : String) : VerifiedProviderDepositUpdate
    }

    class "DepositEventPublisher" <<(V, #FFA726) Service>> {
        - eventService : EventService
        + on(event : DepositSucceededEvent) : void
        + on(event : DepositFailedEvent) : void
        + on(event : DepositCancelledEvent) : void
    }

    interface "EventService" <<(O, #78909C) Outbound Service>> {
        + publishEvent(event : IntegrationEvent) : void
    }
}

package "infrastructure.persistence.jpa.repositories" {
    interface "DepositViewRepository" <<(R, #90A4AE) Repository>> {
        + findByDepositId(depositId : UUID) : DepositViewEntity
        + findByAccountId(accountId : UUID, page : Pageable) : List<DepositViewEntity>
    }

    interface "ProviderWebhookInboxRepository" <<(R, #90A4AE) Repository>> {
        + insertIfAbsent(...) : int
        + claimDue(now : Instant, maxAttempts : int, batchSize : int) : List<ProviderWebhookInbox>
    }

    interface "DepositProviderReferenceRepository" <<(R, #90A4AE) Repository>> {
        + findByProviderAndProviderDepositId(provider : Provider, providerDepositId : ProviderDepositId) : Optional
        + insertIfAbsent(...) : int
    }

    interface "DepositCommandIdempotencyRepository" <<(R, #90A4AE) Repository>> {
        + insertIfAbsent(...) : int
        + findByAccountIdAndIdempotencyKey(accountId : AccountId, idempotencyKey : String) : Optional<DepositCommandIdempotency>
    }

    interface "WalletViewRepository" <<(R, #90A4AE) Repository>> {
        + findByWalletId(walletId : WalletId) : Optional<WalletViewEntity>
        + existsByWalletId(walletId : WalletId) : boolean
    }

    interface "WalletMovementRepository" <<(R, #90A4AE) Repository>> {
        + findByWalletIdOrderByOccurredAtDesc(walletId : WalletId, page : Pageable) : Page<WalletMovementEntity>
        + insertIfAbsent(...) : int
    }
}

' ---------- command delegation ----------
DepositCommandServiceImpl ..|> DepositCommandService : implements >
DepositCommandServiceImpl ..> InitiateDepositCommand : handles >
DepositCommandServiceImpl ..> Deposit : dispatches to >
DepositCommandServiceImpl ..> DepositCommandIdempotencyRepository : checks Idempotency-Key >

WebhookInboxServiceImpl ..|> WebhookInboxService : implements >
WebhookInboxServiceImpl ..> ProviderWebhookInboxRepository : deduplicates and parks >
WebhookInboxServiceImpl ..> DepositProviderReferenceRepository : resolves depositId >
WebhookInboxServiceImpl ..> ApplyProviderDepositUpdateCommand : builds >
WebhookInboxServiceImpl ..> Deposit : dispatches to (via CommandGateway directly, still) >

DepositProviderReferenceRegisteredEventHandler ..> DepositProviderReferenceRepository : writes >

Deposit ..> RegisterDepositProviderReferenceCommand : handles >

' ---------- query delegation ----------
DepositQueryServiceImpl ..|> DepositQueryService : implements >
DepositQueryServiceImpl ..> GetDepositByIdQuery : handles >
DepositQueryServiceImpl ..> ListDepositsByAccountQuery : handles >
DepositQueryServiceImpl ..> DepositViewRepository : reads >
DepositQueryServiceImpl ..> DepositSummary : returns >

DepositProjection ..> DepositViewRepository : writes >

WalletProjection ..|> WalletQueryService : implements >
WalletProjection ..> GetWalletBalanceQuery : handles >
WalletProjection ..> ListWalletMovementsQuery : handles >
WalletProjection ..> WalletViewRepository : reads and writes >
WalletProjection ..> WalletMovementRepository : reads and writes >
WalletProjection ..> WalletBalance : returns >
WalletProjection ..> WalletMovementPage : returns >

note bottom of DepositCommandServiceImpl
  The service coordinates, it does not decide.
  Invariants live in the aggregate: the service
  never inspects the deposit state to choose
  what to do next.

  It does not call PaymentProvider either: nothing
  reacts to DepositInitiatedEvent yet to create the
  charge, so a deposit created through POST
  /api/v1/deposits stays PENDING. Tracked separately in
  Trello, not this card's scope.
end note

note bottom of DepositQueryServiceImpl
  Queries read the projection. They never load
  the aggregate, so they cost one SQL statement
  instead of a full replay.
end note

note bottom of WalletProjection
  Drawn as the one real class it is — unlike the
  DepositQueryServiceImpl/DepositProjection split
  above, no separate "WalletQueryServiceImpl" exists
  in the code. Each on(...) handler updates
  WalletViewRepository's balance row AND inserts a
  WalletMovementRepository row, in the same
  transaction: two Read Model tables from one event.
end note

legend bottom
  <b>Every use case is declared in domain.services and implemented here.</b>
  The domain states what the use cases are; the application layer wires them to
  Axon, to the provider and to the repositories.

  <b>Following the guide, application depends on infrastructure directly</b> for
  repositories, as CargoBookingCommandService imports CargoRepository. The one
  deliberate inversion is PaymentProvider: declared in outboundservices and
  implemented in infrastructure.providers.stripe, so the use case can be tested
  against a fake without Stripe.

  <b>PaymentProvider declares no types of its own.</b> Its parameters, its three
  return types and its sealed error hierarchy all live in domain: the port states
  what can be asked of a provider, not a vocabulary to ask it in.

  <b>WebhookInboxServiceImpl still dispatches ApplyProviderDepositUpdateCommand
  through Axon's CommandGateway directly.</b> DepositCommandService exists now
  (Card 4), but only declares handle(InitiateDepositCommand) — the REST card
  that introduced it deliberately did not extend it to also cover
  ApplyProviderDepositUpdateCommand or rewire the inbox, to avoid touching
  webhook-inbox code it did not need to change.

  <b>application.internal.eventhandlers is for handlers of OUR OWN events that are
  not the read model projection.</b> DepositProviderReferenceRegisteredEventHandler
  writes finance_ops, which takes part in an admission decision and therefore
  cannot be a projection.

  DepositProjection and DepositEventPublisher are not called by anyone here: the
  Axon event processor invokes them from the event stream.

  <b>DepositEventPublisher has exactly three handlers, and that is the selection.</b>
  The four internal events have none, so there is no list to keep in step with the
  catalogue. EventService is implemented by infrastructure.brokers.kafka.

  <b>WalletMovementRepository is this service's first append-only Read Model table.</b>
  WalletViewRepository upserts one row per wallet, same shape as DepositViewRepository.
  WalletMovementRepository never updates a row once inserted, so it has no
  "already applied" guard to check against — insertIfAbsent (keyed on the event id)
  is the barrier instead, the same idiom finance_ops tables already use for a
  different reason (deduplicating an admission decision, not a projection write).
endlegend

@enduml
