@startuml finance-rest-api-class-diagram

left to right direction

title Vankoo Finance: REST API Class Diagram

skinparam shadowing false
skinparam class {
    BackgroundColor<<Controller>> #FFFFFF/BBDEFB
    BackgroundColor<<Resource>> #FFFFFF/E1F5FE
    BackgroundColor<<Assembler>> #FFFFFF/FFF9C4
    BackgroundColor<<Command>> #FFFFFF/D1C4E9
    BackgroundColor<<Query>> #FFFFFF/B2DFDB
    BackgroundColor<<Query Result>> #FFFFFF/E1BEE7
    BackgroundColor<<Domain Service>> #FFFFFF/FFCCBC
    BorderColor #212121
    ArrowColor #212121
    FontSize 14
}
skinparam interface {
    BackgroundColor #FFFFFF/FFCCBC
    BorderColor #212121
    ArrowColor #212121
    FontSize 14
}

package "interfaces.rest" {

    package "controllers" {
        class "DepositController" <<(C, #42A5F5) Controller>> {
            - depositCommandService : DepositCommandService
            - depositQueryService : DepositQueryService
            + createDeposit(idempotencyKey : String, resource : CreateDepositResource) : ResponseEntity<DepositResource>
            + getDeposit(depositId : String) : ResponseEntity<DepositResource>
            + listDeposits(accountId : String, page : int, size : int) : ResponseEntity<DepositSummaryPageResource>
        }
    }

    package "resources" {
        class "CreateDepositResource" <<(S, #4FC3F7) Resource>> {
            + accountId : String
            + amountMinor : long
            + currency : String
            + provider : String
            + description : String
        }

        class "DepositResource" <<(S, #4FC3F7) Resource>> {
            + depositId : String
            + accountId : String
            + amountMinor : long
            + currency : String
            + provider : String
            + status : String
            + actionUrl : String
            + failureReason : String
            + description : String
            + cancellationReason : String
            + createdAt : String
            + updatedAt : String
        }

        class "DepositSummaryPageResource" <<(S, #4FC3F7) Resource>> {
            + items : List<DepositResource>
            + pageNumber : int
            + pageSize : int
            + totalElements : long
        }
    }

    package "transform" {
        class "CreateDepositCommandFromResourceAssembler" <<(A, #FDD835) Assembler>> {
            + {static} toCommandFromResource(resource : CreateDepositResource, idempotencyKey : String) : InitiateDepositCommand
            + {static} toPendingResourceFrom(depositId : DepositId, resource : CreateDepositResource) : DepositResource
        }

        class "DepositResourceFromSummaryAssembler" <<(A, #FDD835) Assembler>> {
            + {static} toResourceFromSummary(summary : DepositSummary) : DepositResource
        }

        class "DepositSummaryPageResourceFromPageAssembler" <<(A, #FDD835) Assembler>> {
            + {static} toResourceFromPage(page : DepositSummaryPage) : DepositSummaryPageResource
        }
    }
}

package "domain.model" {
    class "InitiateDepositCommand" <<(C, #9575CD) Command>> {
    }

    class "GetDepositByIdQuery" <<(Q, #4DB6AC) Query>> {
    }

    class "ListDepositsByAccountQuery" <<(Q, #4DB6AC) Query>> {
    }

    class "DepositSummary" <<(R, #BA68C8) Query Result>> {
    }

    class "DepositSummaryPage" <<(R, #BA68C8) Query Result>> {
    }
}

package "domain.services" {
    interface "DepositCommandService" <<(S, #FF8A65) Domain Service>> {
        + handle(command : InitiateDepositCommand) : DepositId
    }

    interface "DepositQueryService" <<(S, #FF8A65) Domain Service>> {
        + getDepositById(query : GetDepositByIdQuery) : Optional<DepositSummary>
        + listDepositsByAccount(query : ListDepositsByAccountQuery) : DepositSummaryPage
    }
}

' ---------- inbound: resource becomes a command ----------
DepositController --> CreateDepositResource : receives >
DepositController ..> CreateDepositCommandFromResourceAssembler : uses >
CreateDepositCommandFromResourceAssembler ..> CreateDepositResource : reads >
CreateDepositCommandFromResourceAssembler ..> InitiateDepositCommand : builds >
DepositController ..> DepositCommandService : dispatches >
DepositCommandService ..> InitiateDepositCommand : handles >

' ---------- outbound: query result becomes a resource ----------
DepositController ..> GetDepositByIdQuery : builds >
DepositController ..> ListDepositsByAccountQuery : builds >
DepositController ..> DepositQueryService : queries >
DepositQueryService ..> GetDepositByIdQuery : handles >
DepositQueryService ..> ListDepositsByAccountQuery : handles >
DepositQueryService ..> DepositSummary : returns >
DepositQueryService ..> DepositSummaryPage : returns >
DepositController ..> DepositResourceFromSummaryAssembler : uses >
DepositResourceFromSummaryAssembler ..> DepositSummary : reads >
DepositResourceFromSummaryAssembler ..> DepositResource : builds >
DepositController ..> DepositSummaryPageResourceFromPageAssembler : uses >
DepositSummaryPageResourceFromPageAssembler ..> DepositSummaryPage : reads >
DepositSummaryPageResourceFromPageAssembler ..> DepositResourceFromSummaryAssembler : delegates each item to >
DepositSummaryPageResourceFromPageAssembler ..> DepositSummaryPageResource : builds >
DepositController --> DepositResource : returns >
DepositController --> DepositSummaryPageResource : returns >

note bottom of DepositController
  The controller holds no business rules.
  It validates the request format, delegates,
  and translates the answer back.
  It never touches a repository or Axon directly.
end note

note right of CreateDepositCommandFromResourceAssembler
  Assemblers are static, like the guide's
  BookCargoCommandDTOAssembler. The
  Idempotency-Key arrives as an HTTP header,
  not in the body, so the controller passes it
  in explicitly.

  toPendingResourceFrom builds the 202 body for
  a *first-time* create without querying: the
  projection's @EventHandler runs on Axon's own
  processor, not inside sendAndWait, so querying
  right after dispatch risks reading before the
  row exists. A replay (same Idempotency-Key,
  same content) is safe to query for real, since
  the deposit has existed for a while by then.
end note

legend bottom
  <b>Naming convention:</b> CreateXResource for a request, XResource for a response.

  <b>Three types, three layers.</b> The resource is the API contract, the command is
  the intent, and DepositSummary is the query answer. The resource never reaches
  the domain and the aggregate never reaches the API.

  POST /v1/deposits answers 202 Accepted with the depositId in PENDING: the
  provider call and the projection update happen afterwards. Nothing triggers
  that provider call yet (Card 8 gap, tracked separately) — a deposit created
  through this endpoint stays PENDING today.

  A repeated Idempotency-Key with the same content answers 202 with the
  deposit's real current status, not always PENDING: DepositController tells a
  replay apart from a first-time create by comparing the depositId it minted
  against the one DepositCommandService.handle(...) returns.
endlegend

@enduml
