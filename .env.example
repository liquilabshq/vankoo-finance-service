# vankoo-finance-service — variables de entorno
#
# Copia este archivo a .env y rellena los valores. .env está en .gitignore:
# nunca lo commitees, lleva credenciales reales.
#
# Todos los valores de abajo son los defaults del perfil `dev`
# (src/main/resources/application-dev.yaml), salvo los que dicen SIN DEFAULT.
# Si el default te sirve, puedes borrar la línea.
#
# La configuración de Stripe está explicada en docs/guides/stripe-configuration.md.

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------

# Pon false para desactivar las llamadas SALIENTES a Stripe (createDeposit,
# getDeposit). OJO: no desactiva la verificación de webhooks entrantes.
STRIPE_ENABLED=true

# SIN DEFAULT. Developers → API keys en el dashboard. Usa siempre la de prueba
# (sk_test_...) en desarrollo. Es un secreto: no la pegues en Slack ni en el repo.
STRIPE_SECRET_KEY=sk_test_TU_CLAVE_SECRETA_DE_PRUEBA

# SIN DEFAULT. Empieza por whsec_. En local sale de `stripe listen`; en un entorno
# desplegado, de Developers → Webhooks → tu endpoint. Son valores DISTINTOS.
STRIPE_WEBHOOK_SECRET=whsec_TU_SECRETO_DE_WEBHOOK

# SIN DEFAULT ambas. A dónde manda Stripe al inversor al terminar el Checkout.
# Deben ser URLs absolutas; Stripe rechaza la sesión si no lo son.
STRIPE_SUCCESS_URL=http://localhost:5173/deposits/success
STRIPE_CANCEL_URL=http://localhost:5173/deposits/cancel

# ---------------------------------------------------------------------------
# Base de datos (PostgreSQL)
# ---------------------------------------------------------------------------
# Guarda el Read Model (finance_read_model) y las tablas operativas (finance_ops).
# NO guarda los eventos de dominio: eso es Axon Server, más abajo.

FINANCE_DB_HOST=localhost
# 5434 y no 5432: IAM y Profile ya ocupan 5432 y 5433 en el compose de vankoo-infra.
FINANCE_DB_PORT=5434
FINANCE_DB_NAME=vankoo_finance_db_dev
FINANCE_DB_USERNAME=admin
FINANCE_DB_PASSWORD=password

# ---------------------------------------------------------------------------
# Axon Server (Event Store)
# ---------------------------------------------------------------------------
# Aquí viven los eventos de dominio. Es un almacén aparte de PostgreSQL, con su
# propio respaldo. Ver docs/adr/0002 sobre la licencia y el modo standalone.

AXON_SERVER_HOST=localhost
# Puerto gRPC, no el de la consola web (esa es el 8024).
AXON_SERVER_PORT=8124

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------
# Topic vankoo.finance.events.v1, para los eventos de integración. En la v1 no
# tiene consumidor: se publica para fijar el contrato.

KAFKA_HOST=localhost
# 9092 desde tu máquina; 9094 es el listener interno entre contenedores.
KAFKA_EXTERNAL_PORT=9092
KAFKA_INTERNAL_PORT=9094

# ---------------------------------------------------------------------------
# Inbox de webhooks
# ---------------------------------------------------------------------------
# Deduplicación, orden de llegada y reintentos de los webhooks de Stripe.

# Cada cuánto se barre el inbox. Es también la latencia peor caso de un webhook:
# el 200 a Stripe no espera al comando, el comando sale en el siguiente barrido.
WEBHOOK_INBOX_POLL_INTERVAL=2s
WEBHOOK_INBOX_BATCH_SIZE=20
# Con el backoff de abajo, 12 intentos cubren algo más de una hora antes de que
# la fila deje de reintentarse y quede PARKED esperando a un humano.
WEBHOOK_INBOX_MAX_ATTEMPTS=12
WEBHOOK_INBOX_BACKOFF_BASE=5s
WEBHOOK_INBOX_BACKOFF_MAX=10m

# ---------------------------------------------------------------------------
# Descubrimiento de servicios y documentación
# ---------------------------------------------------------------------------

DISCOVERY_SERVER_URL=http://localhost:8761/eureka/
FINANCE_SERVICE_PORT=8083
API_GATEWAY_PORT=8080
